{
  "$schema": "node_modules/@ztools-center/ztools-api-types/resource/ztools.schema.json",
  "name": "m-deeplx-vue",
  "title": "DX翻译",
  "description": "多引擎智能翻译助手，支持文本翻译与截图 OCR 翻译。",
  "author": "m-deeplx-vue",
  "version": "0.1.0",
  "main": "index.html",
  "logo": "logo.png",
  "preload": "preload.js",
  "platform": [
    "win32",
    "darwin",
    "linux"
  ],
  "development": {
    "main": "http://127.0.0.1:8080"
  },
  "features": [
    {
      "code": "dx翻译",
      "explain": "ai翻译,dx翻译,自己部署翻译服务器,全世界最准确的ai专项翻译,系统能快速、自动地识别语言，将单词转化为你想要的语言，并尝试添加特殊的语言细微差别和表达方式。",
      "icon": "logo.png",
      "cmds": [
        "deepl",
        "mdeepl",
        "dx",
        "ai翻译",
        "dx翻译",
        "fy",
        {
          "type": "over",
          "label": "dx翻译",
          "exclude": "/xxx/i",
          "minLength": 1,
          "maxLength": 10000
        },
        {
          "type": "over",
          "label": "ai翻译",
          "exclude": "/xxx/i",
          "minLength": 1,
          "maxLength": 10000
        }
      ]
    }
  ]
}
